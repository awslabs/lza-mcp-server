FROM python:3.13-slim

# Create non-root user
RUN groupadd -r lzauser && useradd -r -g lzauser -d /app -s /bin/bash lzauser

# Set working directory
WORKDIR /app

# Copy project files
COPY . /app/
COPY lza-minimum-configuration/ /app/lza-minimum-configuration/

# Install dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e .

# Set environment variables
ENV PYTHONPATH="/app"
ENV FASTMCP_LOG_LEVEL="INFO"
ENV AWS_DEFAULT_REGION="us-east-1"

# Create .aws directory for mounted credentials
RUN mkdir -p /home/lzauser/.aws && chown -R lzauser:lzauser /home/lzauser/.aws

# Change ownership to non-root user
RUN chown -R lzauser:lzauser /app

# Switch to non-root user
USER lzauser

# Expose port for MCP server
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

# Entry point
ENTRYPOINT ["python", "-m", "awslabs.lza_mcp_server"]