# Use Ubuntu 22.04 base image
FROM ubuntu:22.04

# Build argument for LZA release version (defaults to latest if not specified)
ARG LZA_RELEASE=""
# If using a different repo URL, you MUST specify version to use
ARG LZA_REPO_URL="https://github.com/awslabs/landing-zone-accelerator-on-aws.git"

# Set environment variables
ENV PYTHONPATH="/app"
ENV FASTMCP_LOG_LEVEL="INFO"
ENV AWS_DEFAULT_REGION="us-east-1"
ENV LZA_MIN_CONFIG_DIR="/app/lza-minimum-configuration"
ENV DEBIAN_FRONTEND=noninteractive

# Set shell with pipefail for better error handling
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Create non-root user
RUN groupadd -r lzauser && useradd -r -g lzauser -d /app -s /bin/bash lzauser

# Set working directory
WORKDIR /app

# Copy project files
COPY . /app/

# Explicitly copy lza-minimum-configuration directory
COPY lza-minimum-configuration/ /app/lza-minimum-configuration/

# Create .aws directory for mounted credentials
RUN mkdir -p /home/lzauser/.aws && chown -R lzauser:lzauser /home/lzauser/.aws

# Change ownership to non-root user
RUN chown -R lzauser:lzauser /app

# Install base packages and Python
RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  python3.10 \
  python3-pip \
  lsof \
  curl \
  gnupg \
  lsb-release \
  git \
  ca-certificates && \
  curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
  apt-get install -y nodejs && \
  npm install -g yarn && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/*

# Install dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir loguru pydantic pyyaml mcp fastapi uvicorn psutil && \
    pip install --no-cache-dir -e .

# Switch to non-root user
USER lzauser

# Clone the LZA repository and set up validator
RUN mkdir -p /app/lza && \
  if [ -z "$LZA_RELEASE" ]; then \
    echo "No LZA_RELEASE specified, fetching latest release..." && \
    LATEST_RELEASE=$(curl -s https://api.github.com/repos/awslabs/landing-zone-accelerator-on-aws/releases/latest | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/') && \
    echo "Using latest release: $LATEST_RELEASE" && \
    git clone --branch "$LATEST_RELEASE" --depth 1 "$LZA_REPO_URL" /app/lza; \
  else \
    echo "Using specified LZA release: $LZA_RELEASE" && \
    git clone --branch "$LZA_RELEASE" --depth 1 "$LZA_REPO_URL" /app/lza; \
  fi && \
  cd /app/lza/source && \
  chmod -R 755 /app/lza && \
  yarn install && \
  yarn build

# Create JSON schema files
RUN chmod +x /app/docker-json-schema.sh && /app/docker-json-schema.sh

# Expose port for MCP server
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import sys; sys.exit(0)"

# Entry point
ENTRYPOINT ["python3", "-m", "awslabs.lza_mcp_server"]