{
  "mcpServers": {
    "lza-mcp-server": {
      "command": "~/xdev/mte/lza-mcp-server/scripts/extract-aws-credentials.sh",
      "args": [
        "finch",
        "run",
        "--rm",
        "--interactive",
        "-e",
        "FASTMCP_LOG_LEVEL=INFO",
        "-e",
        "AWS_ACCESS_KEY_ID",
        "-e",
        "AWS_SECRET_ACCESS_KEY",
        "-e",
        "AWS_SESSION_TOKEN",
        "-e",
        "AWS_REGION",
        "lza-mcp-server:local"
      ],
      "env": {
        "AWS_PROFILE": "default"
      },
      "disabled": false,
      "autoApprove": [
      ]
    }
  }
}