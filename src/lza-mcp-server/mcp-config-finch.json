{
  "mcpServers": {
    "lza-mcp-server": {
      "command": "finch",
      "args": [
        "run",
        "--rm",
        "--interactive",
        "-v", "/Users/<YOUR_USERNAME>/.aws:/home/lzauser/.aws:ro",
        "-e", "AWS_PROFILE=default",
        "-e", "AWS_REGION=us-east-1",
        "-e", "FASTMCP_LOG_LEVEL=INFO",
        "lza-mcp-server:local"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
      ]
    }
  }
}