{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "STSAccess",
            "Effect": "Allow",
            "Action": "sts:GetCallerIdentity",
            "Resource": "*"
        },
        {
            "Sid": "SSMParameterAccess",
            "Effect": "Allow",
            "Action": [
                "ssm:GetParameter",
                "ssm:GetParametersByPath"
            ],
            "Resource": "arn:${PARTITION}:ssm:${HOME-REGION}:${ORCHESTRATION_ACCOUNT}:parameter/accelerator/*"
        },
        {
            "Sid": "SSMDescribeParameters",
            "Effect": "Allow",
            "Action": "ssm:DescribeParameters",
            "Resource": "*"
        },
        {
            "Sid": "S3ConfigAccess",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": [
                "arn:${PARTITION}:s3:::${QUALIFIER}-config-*/lza/*"
            ]
        },
        {
            "Sid": "S3ListBucket",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:${PARTITION}:s3:::${QUALIFIER}-config-*"
        },
        {
            "Sid": "KMSEncryptionAccess",
            "Effect": "Allow",
            "Action": [
                "kms:Decrypt",
                "kms:GenerateDataKey"
            ],
            "Resource": "arn:${PARTITION}:kms:*:${ORCHESTRATION_ACCOUNT}:key/*",
            "Condition": {
                "ForAnyValue:StringEquals": {
                    "kms:ResourceAliases": "alias/accelerator/${QUALIFIER}/installer/kms/key"
                }
            }
        },
        {
            "Sid": "DeploymentTypeDetection",
            "Effect": "Allow",
            "Action": [
                "codepipeline:ListPipelines",
                "ecs:ListClusters"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ECSTaskMonitoring",
            "Effect": "Allow",
            "Action": [
                "ecs:DescribeTasks",
                "ecs:ListTasks"
            ],
            "Resource": "arn:${PARTITION}:ecs:${HOME-REGION}:${ORCHESTRATION_ACCOUNT}:cluster/${QUALIFIER}-*"
        },
        {
            "Sid": "CloudWatchLogsECSAccess",
            "Effect": "Allow",
            "Action": [
                "logs:GetLogEvents",
                "logs:DescribeLogStreams"
            ],
            "Resource": "arn:${PARTITION}:logs:${HOME-REGION}:${ORCHESTRATION_ACCOUNT}:log-group:/ecs/${QUALIFIER}-*:*"
        },
        {
            "Sid": "SSMAutomationAccess",
            "Effect": "Allow",
            "Action": [
                "ssm:StartAutomationExecution",
                "ssm:GetAutomationExecution",
                "ssm:DescribeAutomationExecutions",
                "ssm:DescribeDocument"
            ],
            "Resource": [
                "arn:${PARTITION}:ssm:${HOME-REGION}:${ORCHESTRATION_ACCOUNT}:document/${QUALIFIER}-*",
                "arn:${PARTITION}:ssm:${HOME-REGION}:${ORCHESTRATION_ACCOUNT}:automation-execution/*"
            ]
        },
        {
            "Sid": "SSMAutomationPassRole",
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "arn:${PARTITION}:iam::${ORCHESTRATION_ACCOUNT}:role/LZA-Container-Infrastructure-SsmAutomationRole-*",
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": "ssm.amazonaws.com"
                }
            }
        }
    ]
}